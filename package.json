{
  "name": "@codecell-germany/sevdesk-agent-skill",
  "version": "0.1.10",
  "private": false,
  "description": "Agent-first sevdesk bookkeeping CLI and skill for contacts, quotes, invoices, vouchers, and transaction workflows",
  "keywords": [
    "sevdesk",
    "bookkeeping",
    "accounting",
    "invoice",
    "voucher",
    "agent",
    "codex-skill",
    "cli"
  ],
  "license": "MIT",
  "author": "Nikolas Gottschol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecell-germany/sevdesk-agent-skill.git"
  },
  "homepage": "https://github.com/codecell-germany/sevdesk-agent-skill#readme",
  "bugs": {
    "url": "https://github.com/codecell-germany/sevdesk-agent-skill/issues"
  },
  "bin": {
    "sevdesk-agent": "dist/index.js",
    "sevdesk-agent-skill": "dist/installer.js"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/ensure-executable.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:live": "vitest run tests/integration",
    "test:all": "vitest run",
    "prepack": "npm run build && npm run test:unit && node dist/index.js docs read-ops --output knowledge/READ_OPERATIONS.md"
  },
  "files": [
    "dist/**",
    "skills/**",
    "knowledge/READ_OPERATIONS.md",
    "knowledge/SEVDESK_ORDER_WRITE_LEARNINGS.md",
    "OPERATIONS.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^6.0.2",
    "vitest": "^4.0.18"
  }
}
